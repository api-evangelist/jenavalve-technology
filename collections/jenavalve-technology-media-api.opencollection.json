{
  "opencollection": "1.0.0",
  "info": {
    "name": "Jenavalve Technology Media API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Media",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List media library items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://discover-ar.com/wp-json/wp/v2/media",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "One-based page of the collection to return."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Items per page. Maximum 100."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Limit results to those matching a free-text string."
              },
              {
                "name": "_fields",
                "value": "",
                "type": "query",
                "description": "Sparse fieldset — comma-separated list of top-level fields to include."
              },
              {
                "name": "media_type",
                "value": "",
                "type": "query",
                "description": "Limit to a media type."
              }
            ]
          },
          "docs": "Lists uploaded media — 63 items on 2026-08-04."
        },
        {
          "info": {
            "name": "Get a media item by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://discover-ar.com/wp-json/wp/v2/media/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique numeric identifier for the object."
              }
            ]
          },
          "docs": "Get a media item by ID"
        }
      ]
    }
  ],
  "bundled": true
}